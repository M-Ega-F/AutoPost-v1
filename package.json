{
  "name": "autopost-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Social Auto Poster MVP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx src/workers/publish-worker.ts",
    "webhook-worker": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx src/workers/webhook-worker.ts",
    "test": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx --import ./tests/register.ts --test \"tests/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:integration",
    "diagnostic:meta": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx scripts/check-meta-config.ts",
    "seed:user": "node --conditions=react-server --require ./scripts/node-os-compat.cjs --import tsx scripts/seed-user.ts",
    "test:auth": "node scripts/test-auth.ts",
    "db:generate": "node --require ./scripts/node-os-compat.cjs node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --require ./scripts/node-os-compat.cjs node_modules/drizzle-kit/bin.cjs migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.53.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.487.0",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.8.3"
  }
}
